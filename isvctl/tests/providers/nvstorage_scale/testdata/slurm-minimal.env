# Minimal Slurm sweep — golden-file input. Covers exactly what env_used.yaml omits.
SST_SUBSTRATE=slurm
SST_RESULTS_DIR=/scratch/scale-test/results
SST_LOGS_DIR=/scratch/scale-test/logs
SST_PARTITION=all
SST_RUN_TIME=0-01:00:00
SST_CLIENT_TYPE=cpu
SST_CLIENT_ARCH=x86_64
SST_TEST_DIRS=/scratch/scale-test/data:1
SST_THREADS=1,4
SST_IO_SIZES=1M
SST_DURATION=15
SST_FS_MAX_AGG_THROUGHPUT=5
